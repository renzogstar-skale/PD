{
  "expo": {
    "name": "Prince Distributors B2B",
    "slug": "prince-distributors-mobile",
    "version": "1.0.0",
    "scheme": "princedistributors",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.princedistributors.b2b"
    },
    "android": {
      "package": "com.princedistributors.b2b",
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
