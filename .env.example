# Prince Distributors — Configuración de Entorno (Producción)

# Modo de ejecución (production, dev, demo)
GROCY_MODE=production

# Idioma predeterminado y Zona Horaria
GROCY_DEFAULT_LOCALE=es
GROCY_TIMEZONE=America/Bogota

# Moneda oficial del sistema (ISO 4217)
GROCY_CURRENCY=USD

# Puerto del servidor web (asignado dinámicamente por Railway / Render / AWS)
PORT=8080

# URL Base pública de la plataforma (ej. https://prince.up.railway.app)
GROCY_BASE_URL=/

# Directorio de datos persistentes (por defecto /var/www/html/data)
GROCY_DATAPATH=/var/www/html/data

# Configuración de base de datos PostgreSQL (opcional para Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/prince_distributors?schema=public
